#!/bin/sh /etc/rc.common
# procd service of the independent Nethera priority worker

START=99
STOP=10
USE_PROCD=1

PROG=/usr/bin/nethera-priority

validate_agent_section() {
	uci_load_validate nethera agent "$1" "$2" \
		'enabled:bool:0' \
		'router_id:uinteger' \
		'broker:host' \
		'transport:or("wss", "ws", "tcp"):wss' \
		'port:port' \
		'ws_path:string:/mqtt' \
		'username:string' \
		'password:string' \
		'interval:uinteger:30' \
		'wan_iface:string' \
		'tls_ca:file'
}

start_agent() {
	[ "$2" = 0 ] || {
		logger -t nethera-priority -p daemon.err "invalid settings in /etc/config/nethera, not starting (allowed transports: wss, ws, tcp)"
		return 1
	}
	[ "$enabled" = 1 ] || return 0

	local option
	for option in router_id broker password; do
		eval "[ -n \"\$$option\" ]" || {
			logger -t nethera-priority -p daemon.err "option '$option' is missing in /etc/config/nethera, not starting"
			return 1
		}
	done

	procd_open_instance
	procd_set_param command "$PROG" --priority-only
	# Settings go through the environment, so the password is not visible in the process list
	procd_set_param env \
		NETHERA_ROUTER_ID="$router_id" \
		NETHERA_BROKER="$broker" \
		NETHERA_TRANSPORT="$transport" \
		NETHERA_PORT="$port" \
		NETHERA_WS_PATH="$ws_path" \
		NETHERA_USERNAME="$username" \
		NETHERA_PASSWORD="$password" \
		NETHERA_INTERVAL="$interval" \
		NETHERA_WAN_IFACE="$wan_iface" \
		NETHERA_TLS_CA="$tls_ca"
	procd_set_param stderr 1
 procd_set_param term_timeout 15
	# Restart 5 s after an unexpected exit, without a retry limit
	procd_set_param respawn 3600 5 0
	procd_close_instance
}

start_service() {
	validate_agent_section agent start_agent
}

service_triggers() {
	procd_add_reload_trigger nethera
	procd_add_validation validate_agent_section
}

# Run after procd has stopped the worker, so reconciliation cannot recreate queues.
service_stopped() {
 if [ -f /etc/init.d/nethera-autorate ] && grep -q "# Nethera priority adaptive controller" /etc/init.d/nethera-autorate; then
  /etc/init.d/nethera-autorate stop
 fi
	"$PROG" --priority-remove
}
