#!/bin/sh /etc/rc.common
# Nethera priority adaptive controller -- owns no network/UCI configuration.
USE_PROCD=1
START=99
STOP=9
start_service() {
 [ -f /var/run/nethera-priority/config.nethera-priority.sh ] || return 0
 procd_open_instance
 procd_set_param command /bin/bash /usr/lib/nethera-priority/cake-autorate/cake-autorate.sh /var/run/nethera-priority/config.nethera-priority.sh
 procd_set_param env CAKE_AUTORATE_SCRIPT_PREFIX=/usr/lib/nethera-priority/cake-autorate CAKE_AUTORATE_CONFIG_PREFIX=/var/run/nethera-priority
 procd_set_param stderr 1
 procd_set_param respawn 3600 5 0
 procd_set_param term_timeout 10
 procd_close_instance
}
